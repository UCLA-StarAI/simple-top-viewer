#!/bin/bash
# install-disk-usage — set up the root-visibility disk-usage pipeline on THIS
# machine. Run as root from the shared web directory (next to stats.py);
# deploy-disk-usage does that over ssh for a list of machines.
#
# Nothing here is site-specific: the web directory is the one this script
# sits in, and the publisher runs as that directory's owner — both are
# derived at install time and substituted into the installed copies.
#
# Installs, from the directory this script sits in:
#   diskusage.py       -> /root/bin/diskusage.py            (root:root 0700)
#   update-disk-usage  -> /root/bin/update-disk-usage       (root:root 0700)
#   publish-disk-usage -> /usr/local/bin/publish-disk-usage (root:root 0755)
#   disk-usage.cron    -> /etc/cron.d/disk-usage            (root:root 0644)
# then creates the local drop dir and kicks off a first collection in the
# background so the page gets full data without waiting for tonight's window.

set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

(( EUID == 0 )) || { echo "run as root (sudo $0)" >&2; exit 1; }
HERE=$(cd "$(dirname "$0")" && pwd)
for f in diskusage.py update-disk-usage publish-disk-usage disk-usage.cron; do
    [[ -f "$HERE/$f" ]] || { echo "missing $HERE/$f" >&2; exit 1; }
done
command -v python3 >/dev/null || { echo "python3 missing on $(hostname -s)" >&2; exit 1; }

WEB_DIR="$HERE"
PUBLISH_USER=$(stat -c %U "$WEB_DIR")
getent passwd "$PUBLISH_USER" >/dev/null || {
    echo "cannot resolve owner of $WEB_DIR to a user" >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
sed "s|@WEB_DIR@|$WEB_DIR|g"       "$HERE/publish-disk-usage" > "$tmp/publish-disk-usage"
sed "s|@PUBLISH_USER@|$PUBLISH_USER|g" "$HERE/disk-usage.cron" > "$tmp/disk-usage.cron"

install -o root -g root -m 0700 -D "$HERE/diskusage.py"       /root/bin/diskusage.py
install -o root -g root -m 0700 -D "$HERE/update-disk-usage"  /root/bin/update-disk-usage
install -o root -g root -m 0755 -D "$tmp/publish-disk-usage"  /usr/local/bin/publish-disk-usage
install -o root -g root -m 0644 -D "$tmp/disk-usage.cron"     /etc/cron.d/disk-usage
install -d -o root -g root -m 0755 /var/lib/disk-usage

# First collection now, ignoring the staleness/load gates; backgrounded so
# the install (and the ssh session driving it) doesn't wait on a full du.
nohup /root/bin/update-disk-usage --force >/dev/null 2>&1 &
disown

echo "installed on $(hostname -s): publishing to $WEB_DIR as $PUBLISH_USER; first collection running"
